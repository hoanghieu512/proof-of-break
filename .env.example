# Copy to .env and fill in. .env is gitignored — never commit real keys.

ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_RPC_URL_ALT=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002

# Arcscan runs Blockscout, which accepts any non-empty API key string.
ARCSCAN_API_KEY=blockscout-no-key-needed

# Generate each with: cast wallet new
# Keep the two wallets separate — the agent must claim bounties on its own.
DEPLOYER_ADDRESS=0x...
DEPLOYER_PRIVATE_KEY=0x...

AGENT_ADDRESS=0x...
AGENT_PRIVATE_KEY=0x...
